---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = "Ferretería El Tornillo — Catálogo",
  description = "Ferretería familiar con 40 años en zona oeste de GBA. Consultanos por WhatsApp antes de venir al local.",
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e8dcc4" />

    {/* Tipografía — Inter (body) + JetBrains Mono (precios, SKUs, código).
        Bunny Fonts es un mirror libre de Google Fonts sin tracking.
        Preconnect para evitar round-trip en el primer paint. */}
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link rel="stylesheet"
      href="https://fonts.bunny.net/css?family=inter:400,500,600,700|jetbrains-mono:400,500,700&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-[var(--color-rivet)] focus:px-3 focus:py-2 focus:text-[var(--color-paper)] focus:outline-none"
    >
      Saltar al contenido principal
    </a>
    <Header />
    <main id="main" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
