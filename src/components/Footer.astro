---
const phone = "+54 9 11 4567-8900";
const phoneRaw = "5491145678900";
const address = "Av. San Martín 4520, Ituzaingó, Buenos Aires";
const hours = [
  { day: "Lun a Vie", open: "08:30", close: "19:00" },
  { day: "Sábados", open: "08:30", close: "13:30" },
  { day: "Domingos", open: "Cerrado", close: "" },
];

const year = new Date().getFullYear();
---

<footer
  id="contacto"
  class="mt-24 border-t border-[var(--color-line)] bg-[var(--color-ink)] text-[var(--color-paper)]"
>
  <div class="mx-auto max-w-[1400px] px-4 py-16 md:px-8 md:py-24">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-amber)]">
          Ferretería El Tornillo
        </p>
        <h2 class="mt-3 text-3xl font-bold leading-tight md:text-4xl">
          Cuarenta años a una cuadra de tu obra.
        </h2>
        <p class="mt-4 max-w-[40ch] text-base leading-relaxed text-[var(--color-line-soft)]">
          Atendemos en mostrador desde 1985 en zona oeste. Te mostramos lo que hay, te
          decimos si conviene esperar y te lo dejamos listo para retirar.
        </p>
        <a
          href={`https://wa.me/${phoneRaw}?text=${encodeURIComponent("Hola, quiero consultar por un producto.")}`}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-rivet)] px-5 py-3 text-sm font-semibold text-[var(--color-paper)] transition-colors hover:bg-[var(--color-rivet-deep)]"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M20.52 3.48A11.94 11.94 0 0 0 12.04 0C5.46 0 .12 5.34.12 11.92c0 2.1.55 4.16 1.6 5.96L0 24l6.28-1.64a11.92 11.92 0 0 0 5.76 1.47h.01c6.58 0 11.92-5.34 11.92-11.92 0-3.18-1.24-6.18-3.45-8.43z"></path>
          </svg>
          Escribir por WhatsApp
        </a>
      </div>

      <div class="md:col-span-4">
        <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-amber)]">
          Local
        </p>
        <address class="mt-3 not-italic text-base leading-relaxed">
          {address}
        </address>
        <p class="mono mt-3 text-sm text-[var(--color-line-soft)]">{phone}</p>
      </div>

      <div class="md:col-span-3">
        <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-amber)]">
          Horarios
        </p>
        <ul class="mt-3 divide-y divide-[var(--color-iron)]">
          {
            hours.map((h) => (
              <li class="flex items-center justify-between gap-2 py-2 text-sm">
                <span>{h.day}</span>
                <span class="mono text-[var(--color-line-soft)]">
                  {h.open === "Cerrado" ? "—" : `${h.open} a ${h.close} hs`}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-[var(--color-iron)]">
    <div
      class="mx-auto flex max-w-[1400px] flex-col items-start justify-between gap-2 px-4 py-6 text-xs text-[var(--color-line-soft)] md:flex-row md:items-center md:px-8"
    >
      <p class="mono">© {year} · Ferretería El Tornillo · Ituzaingó, BA</p>
      <p class="mono">Catálogo de muestra · Hecho con Astro + Preact</p>
    </div>
  </div>
</footer>
