---
import { PHONE_FORMATTED, whatsappLink } from "../lib/whatsapp";

const phone = PHONE_FORMATTED;
const waFooter = whatsappLink("Hola, quiero consultar por un producto.");
const address = "Av. San Martín 4520, Ituzaingó, Buenos Aires";
const year = new Date().getFullYear();

const hours = [
  { day: "Lun a Vie", open: "08:30", close: "19:00" },
  { day: "Sábados", open: "08:30", close: "13:30" },
  { day: "Domingos", open: "Cerrado", close: "" },
];

const navSections = [
  {
    title: "Catálogo",
    links: [
      { label: "Ver todo", href: "/productos" },
      { label: "Categorías", href: "/categorias" },
      { label: "Comparador", href: "/comparar" },
      { label: "Más vendidos", href: "/productos?sort=name" },
    ],
  },
  {
    title: "La ferretería",
    links: [
      { label: "Nosotros", href: "/nosotros" },
      { label: "Contacto", href: "/contacto" },
      { label: "Dónde encontrarnos", href: "/donde-encontrarnos" },
      { label: "Envíos", href: "/envios" },
    ],
  },
];
---

<footer
  class="mt-24 border-t border-[var(--color-line)] bg-[var(--color-navy)] text-[var(--color-cream)]"
>
  <div class="mx-auto max-w-[1400px] px-4 py-16 md:px-8 md:py-24">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mustard)]">
          Ferretería El Tornillo
        </p>
        <h2 class="mt-3 font-display text-3xl font-bold leading-tight md:text-4xl">
          Cuarenta años a una cuadra de tu obra.
        </h2>
        <p class="mt-4 max-w-[40ch] text-base leading-relaxed text-[var(--color-line-soft)]">
          Atendemos en mostrador desde 1985 en zona oeste. Te mostramos lo que hay, te
          decimos si conviene esperar y te lo dejamos listo para retirar.
        </p>
        <a
          href={waFooter}
          target="_blank"
          rel="noopener"
          class="mono mt-6 inline-flex items-center gap-2 bg-[var(--color-mustard)] px-5 py-3 text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--color-navy)] transition-colors hover:bg-[var(--color-mustard-deep)] active:scale-[0.98]"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M20.52 3.48A11.94 11.94 0 0 0 12.04 0C5.46 0 .12 5.34.12 11.92c0 2.1.55 4.16 1.6 5.96L0 24l6.28-1.64a11.92 11.92 0 0 0 5.76 1.47h.01c6.58 0 11.92-5.34 11.92-11.92 0-3.18-1.24-6.18-3.45-8.43zM12.04 21.8h-.01a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.73.97 1-3.64-.24-.37a9.88 9.88 0 0 1-1.51-5.24c0-5.46 4.45-9.91 9.91-9.91 2.65 0 5.14 1.03 7.01 2.9a9.86 9.86 0 0 1 2.9 7.01c0 5.46-4.45 9.91-9.91 9.91z"></path>
          </svg>
          Escribir por WhatsApp
        </a>
      </div>

      {navSections.map((s) => (
        <div class="md:col-span-2">
          <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mustard)]">
            {s.title}
          </p>
          <ul class="mt-3 space-y-2">
            {s.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-[var(--color-line-soft)] transition-colors hover:text-[var(--color-mustard)]">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="md:col-span-3">
        <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mustard)]">
          Horarios
        </p>
        <table class="spec-table mt-3 w-full text-sm text-[var(--color-cream)]">
          <tbody>
            {
              hours.map((h) => (
                <tr>
                  <td class="font-medium">{h.day}</td>
                  <td class="num text-right text-[var(--color-line-soft)]">
                    {h.open === "Cerrado" ? "CERRADO" : `${h.open} / ${h.close} HS`}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mono mt-4 text-xs text-[var(--color-line-soft)]">{phone}</p>
        <p class="mono mt-1 text-xs text-[var(--color-line-soft)]">{address}</p>
      </div>
    </div>
  </div>

  <div class="border-t border-[var(--color-navy-muted)]">
    <div
      class="mx-auto flex max-w-[1400px] flex-col items-start justify-between gap-2 px-4 py-6 text-[11px] uppercase tracking-[0.12em] text-[var(--color-line-soft)] md:flex-row md:items-center md:px-8"
    >
      <p class="mono">© {year} · Ferretería El Tornillo · Ituzaingó, BA</p>
      <p class="mono">Catálogo de muestra · Hecho con Astro + Preact + Tailwind v4</p>
    </div>
  </div>
</footer>