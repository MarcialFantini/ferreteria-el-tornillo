---
/**
 * ProductCard v2 — editorial, denso.
 *
 * Estructura:
 *   - sticker superior (oferta / destacado / bestSeller / stock bajo)
 *   - imagen con crosshair marks + zoom en hover
 *   - meta header (categoría · SKU)
 *   - título serif
 *   - bloque inferior con precio + acciones (Add / Compare)
 *
 * El componente Preact <ProductActions /> se monta client:load para
 * tener Add-to-Cart desde cualquier página. El resto es HTML estático.
 *
 * Sin @astrojs/react. preact hydrate con client:load.
 */

import { formatPrice, stockLabel } from "../lib/format";
import ProductActions from "./ProductActions";

interface Props {
  product: {
    slug: string;
    name: string;
    category: string;
    brand?: string;
    price: number;
    comparePrice?: number;
    bestSeller?: boolean;
    rating?: number;
    stock: number;
    sku: string;
    image: string;
    imageAlt: string;
    featured?: boolean;
  };
}

const { product } = Astro.props;
const stock = stockLabel(product.stock);
const discount =
  product.comparePrice && product.comparePrice > product.price
    ? Math.round(
        ((product.comparePrice - product.price) / product.comparePrice) * 100,
      )
    : 0;

const ratingVal = product.rating ?? 0;
const lowStock = product.stock > 0 && product.stock < 10;
---

<article
  data-category={product.category}
  data-brand={product.brand ?? ""}
  data-slug={product.slug}
  data-price={product.price}
  data-stock={product.stock}
  class="crosshair has-bottom-crosshairs group relative flex h-full flex-col border border-[var(--color-navy)] bg-[var(--color-cream)] transition-all duration-300 ease-out card-hover hover:border-[var(--color-navy)]"
>
  <span class="ch-bl" aria-hidden="true" />
  <span class="ch-br" aria-hidden="true" />

  {/* Badges apilados */}
  <div class="pointer-events-none absolute left-3 top-3 z-10 flex flex-col items-start gap-1">
    {discount > 0 && (
      <span class="mono pulse-mustard inline-flex items-center bg-[var(--color-mustard)] px-2 py-1 text-[9px] font-bold uppercase tracking-[0.22em] text-[var(--color-navy)]">
        -{discount}%
      </span>
    )}
    {product.bestSeller && (
      <span class="mono inline-flex items-center bg-[var(--color-navy)] px-2 py-1 text-[9px] font-bold uppercase tracking-[0.22em] text-[var(--color-cream)]">
        Más vendido
      </span>
    )}
    {product.featured && (
      <span class="mono inline-flex items-center bg-[var(--color-cream-soft)] px-2 py-1 text-[9px] font-bold uppercase tracking-[0.22em] text-[var(--color-navy)] ring-1 ring-[var(--color-navy)]">
        Destacado
      </span>
    )}
    {lowStock && (
      <span class="mono pulse-mustard inline-flex items-center bg-[var(--color-mark)] px-2 py-1 text-[9px] font-bold uppercase tracking-[0.22em] text-[var(--color-cream)]">
        Últimas {product.stock}
      </span>
    )}
  </div>

  <a
    href={`/productos/${product.slug}`}
    class="relative block aspect-square overflow-hidden bg-[var(--color-cream-deep)]"
    aria-label={`Ver ${product.name}`}
  >
    <img
      src={product.image}
      alt={product.imageAlt}
      loading="lazy"
      decoding="async"
      width="800"
      height="800"
      class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.05]"
    />
    {ratingVal > 0 && (
      <div class="absolute right-3 bottom-3 flex items-center gap-1 bg-[var(--color-cream)]/90 px-2 py-0.5 mono text-[10px] tabular-nums text-[var(--color-navy)] ring-1 ring-[var(--color-navy)]">
        <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14 2 9.27l6.91-1.01z" />
        </svg>
        {ratingVal.toFixed(1)}
      </div>
    )}
  </a>

  <div class="flex flex-1 flex-col gap-3 p-4">
    <div class="flex items-baseline justify-between gap-3 border-b border-[var(--color-line)] pb-2">
      <p class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-navy-muted)] truncate">
        {product.category}
      </p>
      <p class="mono shrink-0 text-[10px] tracking-[0.16em] text-[var(--color-navy-muted)]">
        SKU · {product.sku}
      </p>
    </div>

    <h3 class="font-display text-[17px] font-semibold leading-snug tracking-tight text-[var(--color-navy)] group-hover:text-[var(--color-mustard-deep)]">
      <a href={`/productos/${product.slug}`} class="swipe-underline">
        {product.name}
      </a>
    </h3>

    <div class="mt-auto flex flex-col gap-3 pt-2">
      <div class="flex items-end justify-between">
        <div>
          <p class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-navy-muted)]">
            Precio
          </p>
          <div class="flex items-baseline gap-2">
            <p class="mono text-2xl font-bold tracking-tight text-[var(--color-navy)] tabular-nums">
              {formatPrice(product.price)}
            </p>
            {discount > 0 && (
              <p class="mono text-[11px] text-[var(--color-navy-muted)] line-through tabular-nums">
                {formatPrice(product.comparePrice!)}
              </p>
            )}
          </div>
          <p
            class:list={[
              "mono mt-1 text-[10px] uppercase tracking-[0.16em]",
              stock.tone === "out" && "text-[var(--color-mark)]",
              stock.tone === "low" && "text-[var(--color-mustard-deep)]",
              stock.tone === "ok" && "text-[var(--color-sage)]",
            ]}
          >
            {stock.label}
          </p>
        </div>
      </div>

      <ProductActions
        client:load
        product={{
          slug: product.slug,
          name: product.name,
          sku: product.sku,
          category: product.category,
          price: product.price,
          image: product.image,
        }}
      />

      <a
        href={`/productos/${product.slug}`}
        class="mono -mt-1 text-[10px] uppercase tracking-[0.18em] text-[var(--color-navy-muted)] hover:text-[var(--color-navy)]"
      >
        Ver detalle →
      </a>
    </div>
  </div>
</article>