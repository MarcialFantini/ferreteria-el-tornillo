---
import { formatPrice, stockLabel } from "../lib/format";
import { whatsappLink, productMessage } from "../lib/whatsapp";

interface Props {
  product: {
    slug: string;
    name: string;
    category: string;
    price: number;
    stock: number;
    sku: string;
    image: string;
    imageAlt: string;
    featured?: boolean;
  };
  layout?: "grid" | "list";
}

const { product, layout = "grid" } = Astro.props;
const stock = stockLabel(product.stock);
const wa = whatsappLink(productMessage(product));
---

<article
  data-category={product.category}
  data-slug={product.slug}
  data-price={product.price}
  class:list={[
    "crosshair has-bottom-crosshairs group relative flex flex-col overflow-hidden border border-[var(--color-steel)] bg-[var(--color-kraft)] transition-colors hover:border-[var(--color-rivet)]",
    layout === "grid" ? "h-full" : "md:flex-row",
  ]}
>
  <a
    href={`/productos/${product.slug}`}
    class:list={[
      "relative block overflow-hidden bg-[var(--color-kraft-deep)]",
      layout === "grid" ? "aspect-square" : "aspect-square md:aspect-auto md:w-64 md:shrink-0",
    ]}
  >
    <img
      src={product.image}
      alt={product.imageAlt}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.03]"
      width="800"
      height="800"
    />
    {product.featured && (
      <span
        class="mono absolute left-3 top-3 bg-[var(--color-mark)] px-2 py-1 text-[9px] font-bold uppercase tracking-[0.18em] text-[var(--color-kraft)]"
      >
        Destacado
      </span>
    )}
  </a>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-baseline justify-between gap-3 border-b border-[var(--color-line)] pb-2">
      <p class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-steel-muted)]">
        {product.category}
      </p>
      <p class="mono text-[10px] tracking-[0.18em] text-[var(--color-steel-muted)]">
        SKU · {product.sku}
      </p>
    </div>

    <h3 class="text-[16px] font-semibold leading-snug text-[var(--color-steel)]">
      <a
        href={`/productos/${product.slug}`}
        class="after:absolute after:inset-0 hover:text-[var(--color-rivet)]"
      >
        {product.name}
      </a>
    </h3>

    <div class="mt-auto flex items-end justify-between gap-3 pt-3">
      <div>
        <p class="mono text-[10px] uppercase tracking-[0.16em] text-[var(--color-steel-muted)]">
          Precio
        </p>
        <p class="mono text-2xl font-bold tracking-tight text-[var(--color-steel)]">
          {formatPrice(product.price)}
        </p>
        <p
          class:list={[
            "mono mt-1 text-[10px] uppercase tracking-[0.16em]",
            stock.tone === "out" && "text-[var(--color-mark)]",
            stock.tone === "low" && "text-[var(--color-rivet-deep)]",
            stock.tone === "ok" && "text-[var(--color-steel-muted)]",
          ]}
        >
          {stock.label}
        </p>
      </div>
      <a
        href={wa}
        target="_blank"
        rel="noopener"
        aria-label={`Consultar por ${product.name} vía WhatsApp`}
        class="relative z-10 inline-flex h-10 w-10 shrink-0 items-center justify-center bg-[var(--color-rivet)] text-[var(--color-steel)] transition-transform hover:bg-[var(--color-rivet-deep)] active:scale-[0.95]"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M20.52 3.48A11.94 11.94 0 0 0 12.04 0C5.46 0 .12 5.34.12 11.92c0 2.1.55 4.16 1.6 5.96L0 24l6.28-1.64a11.92 11.92 0 0 0 5.76 1.47h.01c6.58 0 11.92-5.34 11.92-11.92 0-3.18-1.24-6.18-3.45-8.43zM12.04 21.8h-.01a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.73.97 1-3.64-.24-.37a9.88 9.88 0 0 1-1.51-5.24c0-5.46 4.45-9.91 9.91-9.91 2.65 0 5.14 1.03 7.01 2.9a9.86 9.86 0 0 1 2.9 7.01c0 5.46-4.45 9.91-9.91 9.91z"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
