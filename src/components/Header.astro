---
import Brand from "./Brand.astro";
import SearchBar, { type SearchProduct } from "./SearchBar.tsx";
import { getCollection } from "astro:content";

const path = Astro.url.pathname;
const isCatalog = path.startsWith("/productos");

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/productos", label: "Catálogo" },
  { href: "/categorias", label: "Categorías" },
  { href: "/#contacto", label: "Contacto" },
];

// Productos serializados para la isla de búsqueda.
// El searchBlob se pre-computa en el servidor para que el cliente
// no tenga que re-procesar el string cada keystroke.
const allProducts = await getCollection("products");
const searchProducts: SearchProduct[] = allProducts.map((p) => ({
  slug: p.id,
  name: p.data.name,
  category: p.data.category,
  price: p.data.price,
  stock: p.data.stock,
  sku: p.data.sku,
  image: p.data.image,
  searchBlob: [
    p.data.name,
    p.data.sku,
    p.data.category,
    ...(p.data.tags ?? []),
    p.data.brand ?? "",
  ]
    .join(" ")
    .toLowerCase(),
}));
---

<header
  class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-[var(--color-kraft)]/90 backdrop-blur-sm"
>
  <div
    class="mx-auto flex max-w-[1400px] items-center justify-between gap-4 px-4 py-3 md:px-8 md:py-4"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-[var(--color-steel)] no-underline"
      aria-label="Ferretería El Tornillo, ir al inicio"
    >
      <Brand />
      <span class="hidden sm:block">
        <span class="block text-[15px] font-bold leading-none">El Tornillo</span>
        <span class="mono block text-[10px] uppercase tracking-[0.22em] text-[var(--color-steel-muted)]"
          >Ferretería · 1985</span
        >
      </span>
    </a>

    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          navItems.map((item) => {
            const baseHref = item.href.split("#")[0];
            const isAnchorToHome = item.href.startsWith("/#");
            const active =
              !isAnchorToHome &&
              (baseHref === path ||
                (baseHref !== "/" && path.startsWith(`${baseHref}/`)));
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "mono inline-flex items-center uppercase tracking-[0.06em] px-3 py-2 font-medium transition-colors text-[12px]",
                    active
                      ? "bg-[var(--color-steel)] text-[var(--color-kraft)]"
                      : "text-[var(--color-steel-soft)] hover:bg-[var(--color-kraft-deep)] hover:text-[var(--color-steel)]",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <SearchBar client:load products={searchProducts} />

      <a
        href="https://wa.me/5491145678900?text=Hola%2C%20quiero%20consultar%20por%20un%20producto"
        target="_blank"
        rel="noopener"
        class="mono hidden md:inline-flex items-center gap-2 bg-[var(--color-rivet)] px-4 py-2 text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--color-steel)] transition-transform active:scale-[0.98] hover:bg-[var(--color-rivet-deep)]"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="currentColor"
        >
          <path
            d="M20.52 3.48A11.94 11.94 0 0 0 12.04 0C5.46 0 .12 5.34.12 11.92c0 2.1.55 4.16 1.6 5.96L0 24l6.28-1.64a11.92 11.92 0 0 0 5.76 1.47h.01c6.58 0 11.92-5.34 11.92-11.92 0-3.18-1.24-6.18-3.45-8.43zM12.04 21.8h-.01a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.73.97 1-3.64-.24-.37a9.88 9.88 0 0 1-1.51-5.24c0-5.46 4.45-9.91 9.91-9.91 2.65 0 5.14 1.03 7.01 2.9a9.86 9.86 0 0 1 2.9 7.01c0 5.46-4.45 9.91-9.91 9.91z"
          ></path>
        </svg>
        Consultar
      </a>

      <button
        type="button"
        class="crosshair has-bottom-crosshairs inline-flex h-10 w-10 items-center justify-center border border-[var(--color-steel)] bg-[var(--color-kraft)] md:hidden"
        aria-label="Abrir menú"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    hidden
    class="border-t border-[var(--color-line)] bg-[var(--color-kraft)] md:hidden"
  >
    <nav aria-label="Navegación móvil" class="mx-auto max-w-[1400px] px-4 py-3">
      <ul class="flex flex-col gap-1 text-base">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="mono flex items-center justify-between border-b border-[var(--color-line)] px-3 py-3 font-medium text-[12px] uppercase tracking-[0.08em] text-[var(--color-steel-soft)] hover:text-[var(--color-steel)]"
              >
                {item.label}
                <span aria-hidden="true" class="mono">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="https://wa.me/5491145678900?text=Hola%2C%20quiero%20consultar%20por%20un%20producto"
        target="_blank"
        rel="noopener"
        class="mono mt-4 flex items-center justify-center gap-2 bg-[var(--color-rivet)] px-4 py-3 text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--color-steel)]"
      >
        Consultar por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle, accesible.
  const btn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.getElementById("mobile-nav");
  if (btn && panel) {
    btn.addEventListener("click", () => {
      const open = panel.hasAttribute("hidden");
      if (open) {
        panel.removeAttribute("hidden");
        btn.setAttribute("aria-expanded", "true");
      } else {
        panel.setAttribute("hidden", "");
        btn.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>
