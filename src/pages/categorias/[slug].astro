---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "../../data/categories";
import ProductCard from "../../components/ProductCard.astro";

export async function getStaticPaths() {
  // Solo generamos páginas para categorías que efectivamente
  // están en el schema y en el catálogo. Si el frontmatter usa
  // una categoría distinta de las 8 canónicas, esa página no existe.
  return CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props as {
  category: (typeof CATEGORIES)[number];
};

const allProducts = await getCollection("products");
const products = allProducts
  .filter((p) => p.data.category === category.name)
  .map((p) => ({
    slug: p.id,
    name: p.data.name,
    category: p.data.category,
    price: p.data.price,
    stock: p.data.stock,
    sku: p.data.sku,
    image: p.data.image,
    imageAlt: p.data.imageAlt,
    featured: p.data.featured,
  }))
  // Destacados primero, después por nombre.
  .sort((a, b) => {
    if (a.featured !== b.featured) return a.featured ? -1 : 1;
    return a.name.localeCompare(b.name, "es");
  });

// Conteo de stock bajo y sin stock para el resumen del header.
const outOfStock = products.filter((p) => p.stock <= 0).length;
const lowStock = products.filter((p) => p.stock > 0 && p.stock < 10).length;
---

<Layout
  title={`${category.name} · Ferretería El Tornillo`}
  description={category.description}
>
  <nav
    aria-label="Ruta de navegación"
    class="border-b border-[var(--color-line)] bg-[var(--color-paper)]"
  >
    <div
      class="mx-auto flex max-w-[1400px] items-center gap-2 px-4 py-3 text-xs text-[var(--color-ink-soft)] md:px-8"
    >
      <a href="/" class="hover:text-[var(--color-rivet)]">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/categorias" class="hover:text-[var(--color-rivet)]">Categorías</a>
      <span aria-hidden="true">/</span>
      <span class="text-[var(--color-ink)]">{category.name}</span>
    </div>
  </nav>

  <section class="border-b border-[var(--color-line)] bg-[var(--color-paper)]">
    <div class="mx-auto max-w-[1400px] px-4 py-10 md:px-8 md:py-14">
      <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-rivet)]">
        Rubro · {String(products.length).padStart(2, "0")} ítems
      </p>
      <h1
        class="mt-3 text-4xl font-bold leading-[1.05] tracking-tight text-[var(--color-ink)] md:text-5xl"
      >
        {category.name}
      </h1>
      <p class="mt-4 max-w-[64ch] text-base leading-relaxed text-[var(--color-ink-soft)]">
        {category.description}
      </p>
      <dl
        class="mt-8 grid grid-cols-3 gap-4 border-t border-[var(--color-line)] pt-6 md:max-w-lg"
      >
        <div>
          <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
            Disponibles
          </dt>
          <dd class="mt-1 mono text-2xl font-bold tracking-tight text-[var(--color-ink)] md:text-3xl">
            {products.length}
          </dd>
        </div>
        <div>
          <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
            Sin stock
          </dt>
          <dd
            class:list={[
              "mt-1 mono text-2xl font-bold tracking-tight md:text-3xl",
              outOfStock > 0
                ? "text-[var(--color-mark)]"
                : "text-[var(--color-ink)]",
            ]}
          >
            {outOfStock}
          </dd>
        </div>
        <div>
          <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
            Stock bajo
          </dt>
          <dd
            class:list={[
              "mt-1 mono text-2xl font-bold tracking-tight md:text-3xl",
              lowStock > 0
                ? "text-[var(--color-rivet-deep)]"
                : "text-[var(--color-ink)]",
            ]}
          >
            {lowStock}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="bg-[var(--color-paper)] py-12 md:py-16">
    <div class="mx-auto max-w-[1400px] px-4 md:px-8">
      <div class="mb-6 flex items-center justify-between border-b border-[var(--color-line)] pb-3">
        <p class="mono text-[12px] uppercase tracking-[0.12em] text-[var(--color-steel-soft)]">
          <span class="font-bold text-[var(--color-ink)]">
            {products.length}
          </span>{" "}
          {products.length === 1 ? "producto" : "productos"}
        </p>
        <a
          href="/productos"
          class="mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-steel-soft)] hover:text-[var(--color-rivet)]"
        >
          Ver catálogo completo →
        </a>
      </div>

      {
        products.length === 0 ? (
          <div class="crosshair has-bottom-crosshairs relative border border-dashed border-[var(--color-steel-muted)] bg-[var(--color-kraft)] p-10 text-center">
            <span class="ch-bl" aria-hidden="true" />
            <span class="ch-br" aria-hidden="true" />
            <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-steel-muted)]">
              Sin productos publicados
            </p>
            <h2 class="mt-3 text-xl font-semibold text-[var(--color-steel)]">
              Esta categoría todavía no tiene productos en el catálogo.
            </h2>
            <p class="mt-2 text-sm text-[var(--color-steel-soft)]">
              Escribinos por WhatsApp y te contamos qué conseguimos.
            </p>
          </div>
        ) : (
          <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {products.map((p) => (
              <li>
                <ProductCard product={p} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Layout>
