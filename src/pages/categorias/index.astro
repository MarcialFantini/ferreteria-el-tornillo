---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "../../data/categories";

// Conteos por categoría a partir del content collection.
const allProducts = await getCollection("products");
const counts = new Map<string, number>();
for (const p of allProducts) {
  counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
}

// Ordenamos las categorías por nombre legible (es-AR).
const sorted = [...CATEGORIES]
  .map((c) => ({ ...c, count: counts.get(c.name) ?? 0 }))
  .sort((a, b) => a.name.localeCompare(b.name, "es"));

const totalProducts = allProducts.length;
---

<Layout
  title="Categorías · Ferretería El Tornillo"
  description="Todas las categorías del catálogo: herramientas manuales y eléctricas, plomería, electricidad, pinturería, construcción seca, fijaciones y gas."
>
  <nav
    aria-label="Ruta de navegación"
    class="border-b border-[var(--color-line)] bg-[var(--color-paper)]"
  >
    <div
      class="mx-auto flex max-w-[1400px] items-center gap-2 px-4 py-3 text-xs text-[var(--color-ink-soft)] md:px-8"
    >
      <a href="/" class="hover:text-[var(--color-rivet)]">Inicio</a>
      <span aria-hidden="true">/</span>
      <span class="text-[var(--color-ink)]">Categorías</span>
    </div>
  </nav>

  <section class="border-b border-[var(--color-line)] bg-[var(--color-paper)]">
    <div class="mx-auto max-w-[1400px] px-4 py-10 md:px-8 md:py-14">
      <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-rivet)]">
        Catálogo · Rubros
      </p>
      <h1
        class="mt-3 text-4xl font-bold leading-[1.05] tracking-tight text-[var(--color-ink)] md:text-5xl"
      >
        Ocho rubros, todo el mostrador.
      </h1>
      <p class="mt-4 max-w-[58ch] text-base leading-relaxed text-[var(--color-ink-soft)]">
        Cada categoría reúne lo que efectivamente tenemos en depósito. Si no
        aparece lo que buscás, escribinos por WhatsApp y lo conseguimos dentro
        del día.
      </p>
      <dl
        class="mt-8 grid grid-cols-2 gap-4 border-t border-[var(--color-line)] pt-6 md:max-w-md"
      >
        <div>
          <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
            Rubros
          </dt>
          <dd class="mt-1 mono text-3xl font-bold tracking-tight text-[var(--color-ink)]">
            {String(sorted.length).padStart(2, "0")}
          </dd>
        </div>
        <div>
          <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
            Productos
          </dt>
          <dd class="mt-1 mono text-3xl font-bold tracking-tight text-[var(--color-ink)]">
            {String(totalProducts).padStart(2, "0")}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="bg-[var(--color-paper)] py-12 md:py-16">
    <div class="mx-auto max-w-[1400px] px-4 md:px-8">
      <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          sorted.map((c) => (
            <li>
              <a
                href={`/categorias/${c.slug}`}
                class="crosshair has-bottom-crosshairs group relative flex h-full flex-col justify-between border border-[var(--color-steel)] bg-[var(--color-kraft)] p-6 transition-colors hover:border-[var(--color-rivet)]"
              >
                <span class="ch-bl" aria-hidden="true" />
                <span class="ch-br" aria-hidden="true" />
                <div>
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-steel-muted)]">
                      Rubro
                    </p>
                    <p class="mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-steel-muted)]">
                      {String(c.count).padStart(2, "0")} ítems
                    </p>
                  </div>
                  <h2 class="mt-3 text-2xl font-bold leading-tight tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-rivet-deep)]">
                    {c.name}
                  </h2>
                  <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">
                    {c.description}
                  </p>
                </div>
                <div class="mt-6 flex items-center justify-between border-t border-[var(--color-line)] pt-4">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-steel-soft)]">
                    Ver productos
                  </span>
                  <span
                    aria-hidden="true"
                    class="mono text-base text-[var(--color-steel-soft)] transition-colors group-hover:text-[var(--color-rivet)]"
                  >
                    →
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
