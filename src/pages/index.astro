---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { whatsappLink, productMessage } from "../lib/whatsapp";
import ProductCard from "../components/ProductCard.astro";

const allProducts = await getCollection("products");

const featured = allProducts
  .filter((p) => p.data.featured)
  .slice(0, 4)
  .map((p) => ({
    slug: p.id,
    name: p.data.name,
    category: p.data.category,
    price: p.data.price,
    stock: p.data.stock,
    sku: p.data.sku,
    image: p.data.image,
    imageAlt: p.data.imageAlt,
    featured: p.data.featured,
  }));

// Categorías con conteo, ordenadas alfabéticamente.
const categoryCounts = new Map<string, number>();
for (const p of allProducts) {
  categoryCounts.set(p.data.category, (categoryCounts.get(p.data.category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()]
  .sort((a, b) => a[0].localeCompare(b[0], "es"))
  .map(([name, count]) => ({ name, count }));

const wa = whatsappLink(
  "Hola, quiero consultar por un producto del catálogo online.",
);
---

<Layout
  title="Ferretería El Tornillo — Catálogo online · Ituzaingó"
  description="Ferretería familiar con 40 años en zona oeste de GBA. Mostramos nuestro stock y atendemos consultas por WhatsApp."
>
  <!-- HERO -->
  <section class="border-b border-[var(--color-line)] bg-[var(--color-paper)]">
    <div class="mx-auto grid max-w-[1400px] grid-cols-1 gap-12 px-4 py-16 md:grid-cols-12 md:px-8 md:py-24">
      <div class="md:col-span-7">
        <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-rivet)]">
          Ituzaingó · desde 1985
        </p>
        <h1
          class="mt-4 text-4xl font-bold leading-[1.05] tracking-tight text-[var(--color-ink)] md:text-6xl"
        >
          Herramientas y materiales para la obra que estás
          <span class="text-[var(--color-rivet)]">empezando hoy</span>.
        </h1>
        <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-[var(--color-ink-soft)]">
          No tenemos tienda online, pero te mostramos lo que hay en el mostrador. Mirá
          el catálogo, elegí lo que te sirve y consultanos por WhatsApp antes de venir.
          Te confirmamos stock, precio y horario.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/productos"
            class="inline-flex items-center gap-2 rounded-full bg-[var(--color-ink)] px-5 py-3 text-sm font-semibold text-[var(--color-paper)] transition-colors hover:bg-[var(--color-rivet)] active:scale-[0.98]"
          >
            Ver catálogo completo
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={wa}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full border border-[var(--color-ink)] px-5 py-3 text-sm font-semibold text-[var(--color-ink)] transition-colors hover:border-[var(--color-rivet)] hover:text-[var(--color-rivet)] active:scale-[0.98]"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="currentColor"
            >
              <path
                d="M20.52 3.48A11.94 11.94 0 0 0 12.04 0C5.46 0 .12 5.34.12 11.92c0 2.1.55 4.16 1.6 5.96L0 24l6.28-1.64a11.92 11.92 0 0 0 5.76 1.47h.01c6.58 0 11.92-5.34 11.92-11.92 0-3.18-1.24-6.18-3.45-8.43z"
              ></path>
            </svg>
            Consultar por WhatsApp
          </a>
        </div>

        <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-[var(--color-line)] pt-6">
          <div>
            <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
              Años
            </dt>
            <dd class="mt-1 text-2xl font-bold tracking-tight text-[var(--color-ink)] md:text-3xl">
              40
            </dd>
          </div>
          <div>
            <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
              Productos en catálogo
            </dt>
            <dd class="mt-1 text-2xl font-bold tracking-tight text-[var(--color-ink)] md:text-3xl">
              {allProducts.length}
            </dd>
          </div>
          <div>
            <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
              Categorías
            </dt>
            <dd class="mt-1 text-2xl font-bold tracking-tight text-[var(--color-ink)] md:text-3xl">
              {categories.length}
            </dd>
          </div>
        </dl>
      </div>

      <!-- Tarjeta visual del lado derecho: blueprint / placa técnica -->
      <div class="md:col-span-5">
        <div
          class="relative aspect-square overflow-hidden rounded-3xl border border-[var(--color-ink)] bg-[var(--color-paper-deep)] p-6 md:aspect-[4/5]"
        >
          <div
            aria-hidden="true"
            class="absolute inset-0 opacity-20"
            style={`background-image: linear-gradient(to right, var(--color-line) 1px, transparent 1px), linear-gradient(to bottom, var(--color-line) 1px, transparent 1px); background-size: 24px 24px;`}
          >
          </div>
          <div
            aria-hidden="true"
            class="absolute left-3 top-3 h-6 w-6 border-l-2 border-t-2 border-[var(--color-ink)]"
          >
          </div>
          <div
            aria-hidden="true"
            class="absolute right-3 top-3 h-6 w-6 border-r-2 border-t-2 border-[var(--color-ink)]"
          >
          </div>
          <div
            aria-hidden="true"
            class="absolute bottom-3 left-3 h-6 w-6 border-b-2 border-l-2 border-[var(--color-ink)]"
          >
          </div>
          <div
            aria-hidden="true"
            class="absolute bottom-3 right-3 h-6 w-6 border-b-2 border-r-2 border-[var(--color-ink)]"
          >
          </div>

          <div class="relative flex h-full flex-col justify-between">
            <div>
              <p class="mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-iron)]">
                Ficha · Catálogo 2026
              </p>
              <p class="mt-2 text-sm text-[var(--color-ink-soft)]">
                Stock actualizado en mostrador.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-3 text-sm">
              <div class="border-t border-[var(--color-ink)] pt-2">
                <p class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
                  Lu a Vi
                </p>
                <p class="mono mt-1 text-base font-bold text-[var(--color-ink)]">08:30 — 19:00</p>
              </div>
              <div class="border-t border-[var(--color-ink)] pt-2">
                <p class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
                  Sábados
                </p>
                <p class="mono mt-1 text-base font-bold text-[var(--color-ink)]">08:30 — 13:30</p>
              </div>
              <div class="col-span-2 border-t border-[var(--color-ink)] pt-2">
                <p class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
                  Zona
                </p>
                <p class="mt-1 text-base font-semibold text-[var(--color-ink)]">
                  Ituzaingó · Zona Oeste GBA
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORÍAS -->
  <section id="categorias" class="border-b border-[var(--color-line)] bg-[var(--color-paper)] py-16 md:py-24">
    <div class="mx-auto max-w-[1400px] px-4 md:px-8">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-iron)]">
            Sección 02
          </p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-[var(--color-ink)] md:text-4xl">
            Lo que vas a encontrar
          </h2>
        </div>
        <a
          href="/productos"
          class="mono hidden text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink-soft)] hover:text-[var(--color-rivet)] md:inline"
        >
          Ver todo →
        </a>
      </div>

      <ul class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {
          categories.map((c) => (
            <li>
              <a
                href={`/productos?cat=${encodeURIComponent(c.name)}`}
                class="flex h-full flex-col justify-between rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-4 transition-colors hover:border-[var(--color-ink)]"
              >
                <p class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
                  {String(c.count).padStart(2, "0")} ítems
                </p>
                <p class="mt-2 text-base font-semibold leading-snug text-[var(--color-ink)]">
                  {c.name}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- DESTACADOS -->
  <section class="bg-[var(--color-paper)] py-16 md:py-24">
    <div class="mx-auto max-w-[1400px] px-4 md:px-8">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-iron)]">
            Sección 03
          </p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-[var(--color-ink)] md:text-4xl">
            Lo más consultado esta semana
          </h2>
        </div>
        <a
          href="/productos"
          class="mono hidden text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink-soft)] hover:text-[var(--color-rivet)] md:inline"
        >
          Ver catálogo →
        </a>
      </div>

      <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          featured.map((p) => (
            <li>
              <ProductCard product={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA WhatsApp -->
  <section class="border-t border-[var(--color-line)] bg-[var(--color-ink)] py-16 text-[var(--color-paper)] md:py-24">
    <div class="mx-auto max-w-[1400px] px-4 md:px-8">
      <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-12">
        <div class="md:col-span-7">
          <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-amber)]">
            Antes de venir
          </p>
          <h2 class="mt-3 text-3xl font-bold leading-tight md:text-5xl">
            Si no querés perder el viaje, escribinos primero.
          </h2>
          <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-[var(--color-line-soft)]">
            A veces hay cambios de precio de último momento o un producto se agotó en
            la mañana. Un mensaje por WhatsApp nos alcanza para confirmarte todo y
            tenerlo listo para retirar.
          </p>
        </div>
        <div class="md:col-span-5">
          <div class="flex flex-col gap-3">
            <a
              href={wa}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--color-rivet)] px-6 py-4 text-base font-semibold text-[var(--color-paper)] transition-colors hover:bg-[var(--color-rivet-deep)] active:scale-[0.98]"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="currentColor"
              >
                <path
                  d="M20.52 3.48A11.94 11.94 0 0 0 12.04 0C5.46 0 .12 5.34.12 11.92c0 2.1.55 4.16 1.6 5.96L0 24l6.28-1.64a11.92 11.92 0 0 0 5.76 1.47h.01c6.58 0 11.92-5.34 11.92-11.92 0-3.18-1.24-6.18-3.45-8.43z"
                ></path>
              </svg>
              Abrir WhatsApp
            </a>
            <a
              href="tel:+5491145678900"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-[var(--color-line-soft)] px-6 py-4 text-base font-semibold text-[var(--color-paper)] transition-colors hover:border-[var(--color-rivet)] hover:text-[var(--color-rivet)]"
            >
              +54 9 11 4567-8900
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
