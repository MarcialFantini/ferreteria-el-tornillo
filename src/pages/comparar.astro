---
import Layout from "../layouts/Layout.astro";
import CompareView from "../components/CompareView.tsx";
import { getCollection } from "astro:content";

const allProducts = await getCollection("products");

const compareProducts = allProducts.map((p) => ({
  slug: p.id,
  name: p.data.name,
  category: p.data.category,
  brand: p.data.brand ?? "Sin marca",
  price: p.data.price,
  comparePrice: p.data.comparePrice,
  stock: p.data.stock,
  sku: p.data.sku,
  image: p.data.image,
  imageAlt: p.data.imageAlt,
  rating: p.data.rating,
  tags: p.data.tags ?? [],
}));
---

<Layout
  title="Comparar productos · Ferretería El Tornillo"
  description="Compará hasta tres productos lado a lado: precio, stock, marca, SKU y características. Sin trampa, todo lo que ya mostramos en las fichas."
>
  <section class="border-b border-[var(--color-navy)] bg-[var(--color-cream-deep)]">
    <div class="mx-auto max-w-[1400px] px-4 py-10 md:px-8 md:py-14">
      <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mustard-deep)]">
        Herramienta · Comparador
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold leading-[1.05] tracking-tight text-[var(--color-navy)] md:text-5xl">
        Poné hasta <em class="not-italic text-[var(--color-mustard-deep)]">tres productos</em> lado a lado.
      </h1>
      <p class="mt-4 max-w-[64ch] text-base leading-relaxed text-[var(--color-navy-muted)]">
        Marcá desde el catálogo los productos que querés comparar y volvé a esta
        página. Mostramos precio actual, precio anterior si está en oferta, stock,
        marca, SKU y rating para ayudarte a decidir.
      </p>
    </div>
  </section>

  <section class="bg-[var(--color-cream)] py-12 md:py-16">
    <div class="mx-auto max-w-[1400px] px-4 md:px-8">
      <CompareView client:load products={compareProducts} />
    </div>
  </section>
</Layout>