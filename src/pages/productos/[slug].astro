---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { formatPrice, stockLabel } from "../../lib/format";
import { whatsappLink, productMessage } from "../../lib/whatsapp";
import ProductCard from "../../components/ProductCard.astro";
import { categoryHref } from "../../data/categories";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product, all: products },
  }));
}

const { product, all } = Astro.props as {
  product: Awaited<ReturnType<typeof getCollection<"products">>>[number];
  all: Awaited<ReturnType<typeof getCollection<"products">>>;
};

const { Content } = await render(product);
const stock = stockLabel(product.data.stock);
const wa = whatsappLink(productMessage(product.data));

const related = all
  .filter(
    (p) => p.data.category === product.data.category && p.id !== product.id,
  )
  .slice(0, 4)
  .map((p) => ({
    slug: p.id,
    name: p.data.name,
    category: p.data.category,
    price: p.data.price,
    stock: p.data.stock,
    sku: p.data.sku,
    image: p.data.image,
    imageAlt: p.data.imageAlt,
    featured: p.data.featured,
  }));
---

<Layout
  title={`${product.data.name} · El Tornillo`}
  description={product.data.imageAlt}
>
  <nav
    aria-label="Ruta de navegación"
    class="border-b border-[var(--color-line)] bg-[var(--color-paper)]"
  >
    <div
      class="mx-auto flex max-w-[1400px] items-center gap-2 px-4 py-3 text-xs text-[var(--color-ink-soft)] md:px-8"
    >
      <a href="/" class="hover:text-[var(--color-rivet)]">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/productos" class="hover:text-[var(--color-rivet)]">Catálogo</a>
      <span aria-hidden="true">/</span>
      <a
        href={categoryHref(product.data.category)}
        class="hover:text-[var(--color-rivet)]">{product.data.category}</a
      >
      <span aria-hidden="true">/</span>
      <span class="truncate text-[var(--color-ink)]">{product.data.name}</span>
    </div>
  </nav>

  <section class="bg-[var(--color-paper)] py-10 md:py-16">
    <div class="mx-auto grid max-w-[1400px] grid-cols-1 gap-10 px-4 md:grid-cols-12 md:px-8">
      <div class="md:col-span-6">
        <div
          class="overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-paper-deep)]"
        >
          <img
            src={product.data.image}
            alt={product.data.imageAlt}
            width="800"
            height="800"
            class="aspect-square w-full object-cover"
          />
        </div>
      </div>

      <div class="md:col-span-6">
        <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-iron)]">
          {product.data.category}
        </p>
        <h1
          class="mt-3 text-3xl font-bold leading-tight tracking-tight text-[var(--color-ink)] md:text-4xl"
        >
          {product.data.name}
        </h1>

        <dl class="mt-6 grid grid-cols-2 gap-4 border-y border-[var(--color-line)] py-4">
          <div>
            <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
              Precio
            </dt>
            <dd class="mono mt-1 text-3xl font-bold tracking-tight text-[var(--color-ink)]">
              {formatPrice(product.data.price)}
            </dd>
          </div>
          <div>
            <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
              Stock
            </dt>
            <dd
              class:list={[
                "mono mt-1 text-base font-semibold uppercase tracking-[0.16em]",
                stock.tone === "out" && "text-[var(--color-rivet)]",
                stock.tone === "low" && "text-[var(--color-amber)]",
                stock.tone === "ok" && "text-[var(--color-ink-soft)]",
              ]}
            >
              {stock.label}
            </dd>
          </div>
          <div>
            <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
              SKU
            </dt>
            <dd class="mono mt-1 text-base text-[var(--color-ink-soft)]">
              {product.data.sku}
            </dd>
          </div>
          {product.data.brand && (
            <div>
              <dt class="mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-iron)]">
                Marca
              </dt>
              <dd class="mt-1 text-base text-[var(--color-ink-soft)]">
                {product.data.brand}
              </dd>
            </div>
          )}
        </dl>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href={wa}
            target="_blank"
            rel="noopener"
            class="inline-flex flex-1 items-center justify-center gap-2 rounded-full bg-[var(--color-rivet)] px-6 py-4 text-base font-semibold text-[var(--color-paper)] transition-colors hover:bg-[var(--color-rivet-deep)] active:scale-[0.98]"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="currentColor"
            >
              <path
                d="M20.52 3.48A11.94 11.94 0 0 0 12.04 0C5.46 0 .12 5.34.12 11.92c0 2.1.55 4.16 1.6 5.96L0 24l6.28-1.64a11.92 11.92 0 0 0 5.76 1.47h.01c6.58 0 11.92-5.34 11.92-11.92 0-3.18-1.24-6.18-3.45-8.43z"
              ></path>
            </svg>
            Consultar por WhatsApp
          </a>
          <a
            href="tel:+5491145678900"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-[var(--color-ink)] px-6 py-4 text-base font-semibold text-[var(--color-ink)] transition-colors hover:border-[var(--color-rivet)] hover:text-[var(--color-rivet)]"
          >
            Llamar al local
          </a>
        </div>

        <div class="mt-4 flex items-center justify-between gap-3">
          <a
            href="/productos"
            class="mono inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.18em] text-[var(--color-steel-soft)] hover:text-[var(--color-rivet)]"
          >
            <span aria-hidden="true">←</span> Volver al catálogo
          </a>
          <a
            href={categoryHref(product.data.category)}
            class="mono inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.18em] text-[var(--color-steel-soft)] hover:text-[var(--color-rivet)]"
          >
            Más de {product.data.category}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div
          class="prose mt-8 max-w-[60ch] text-[var(--color-ink-soft)] [&_p]:mb-4 [&_p]:leading-relaxed"
        >
          <Content />
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="border-t border-[var(--color-line)] py-16 md:py-24">
        <div class="mx-auto max-w-[1400px] px-4 md:px-8">
          <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-iron)]">
            Otros de la misma categoría
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-[var(--color-ink)] md:text-3xl">
            Más en {product.data.category}
          </h2>
          <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((p) => (
              <li>
                <ProductCard product={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Layout>
