---
/**
 * /favoritos — Lista de productos guardados como favoritos.
 *
 * El almacenamiento vive en localStorage vía el signal `favorites`
 * de `src/lib/cart.ts`. Como Astro es estático, la lectura real
 * la hace una isla Preact (`FavoritesGrid`) que se suscribe al
 * signal y se hidrata al cargar.
 */
import Layout from "../layouts/Layout.astro";
import FavoritesGrid, { type FavoriteProduct } from "../components/FavoritesGrid.tsx";
import { getCollection } from "astro:content";

const allProducts = await getCollection("products");

const favoriteProducts: FavoriteProduct[] = allProducts.map((p) => ({
  slug: p.id,
  name: p.data.name,
  category: p.data.category,
  price: p.data.price,
  comparePrice: p.data.comparePrice,
  stock: p.data.stock,
  sku: p.data.sku,
  image: p.data.image,
  imageAlt: p.data.imageAlt,
}));
---

<Layout
  title="Mis favoritos · Ferretería El Tornillo"
  description="Tus productos guardados de Ferretería El Tornillo. Consultá stock y precio final por WhatsApp."
>
  <nav aria-label="Ruta de navegación" class="border-b border-[var(--color-line)] bg-[var(--color-cream-deep)]">
    <div class="mx-auto flex max-w-[1400px] items-center gap-2 px-4 py-3 text-xs text-[var(--color-navy-muted)] md:px-8">
      <a href="/" class="hover:text-[var(--color-mustard-deep)]">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/productos" class="hover:text-[var(--color-mustard-deep)]">Catálogo</a>
      <span aria-hidden="true">/</span>
      <span class="text-[var(--color-navy)]">Favoritos</span>
    </div>
  </nav>

  <section class="border-b border-[var(--color-navy)] bg-[var(--color-cream-deep)]">
    <div class="mx-auto max-w-[1400px] px-4 py-10 md:px-8 md:py-14">
      <p class="mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mustard-deep)]">
        Mi lista
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold leading-[1.05] tracking-tight text-[var(--color-navy)] md:text-5xl">
        Tus productos <em class="not-italic text-[var(--color-mustard-deep)]">guardados</em>.
      </h1>
      <p class="mt-4 max-w-[64ch] text-base leading-relaxed text-[var(--color-navy-muted)]">
        Los favoritos viven en este dispositivo. Volvé cuando quieras,
        consultá precio y stock por WhatsApp sin volver a buscar.
      </p>
    </div>
  </section>

  <section class="bg-[var(--color-cream)] py-12 md:py-16">
    <div class="mx-auto max-w-[1400px] px-4 md:px-8">
      <FavoritesGrid client:load products={favoriteProducts} />
    </div>
  </section>
</Layout>
